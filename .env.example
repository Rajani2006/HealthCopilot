# CarePilot AI Root Environment Configuration

# Backend port (default: 8000)
PORT=8000

# Allowed CORS origins (comma-separated or * for public demo)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOW_ALL_CORS=false

# Optional Anthropic Claude API Key for narrative explanations and chat
# Leave blank to use built-in deterministic clinical rule engine
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Storage configuration
DB_PATH=carepilot.db
UPLOAD_DIR=uploads
OCR_LANGS=eng
