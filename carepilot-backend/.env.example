# CORS: your React dev server
CORS_ORIGINS=http://localhost:5173
# OCR languages installed in Tesseract (eng+tel+hin+tan needs the matching language packs)
OCR_LANGS=eng
# Optional LLM for richer explanations, chat and translation. Leave empty to use built-in rules.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
DB_PATH=carepilot.db
UPLOAD_DIR=uploads
